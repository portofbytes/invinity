# -----------------------------------------------------------------------------
# Invinity → GitHub Pages deploy config. Copy to scripts/deploy.env, fill in,
# then: bash scripts/deploy.sh
# (scripts/deploy.env is gitignored; this example file is safe to commit.)
# -----------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------
GITHUB_REPO=your-user-or-org/invinity

# --- Optional ---------------------------------------------------------------
GIT_BRANCH=main
REPO_VISIBILITY=private       # or "public"

# Custom domain — pushed into a repo variable, written to out/CNAME during
# build, used by GitHub Pages. You still need to configure DNS at your
# registrar (A records to 185.199.108.153 / .109 / .110 / .111).
CUSTOM_DOMAIN=invinity.ca

# --- App variables (non-secret) --------------------------------------------
NEXT_PUBLIC_SITE_URL=https://invinity.ca
NEXT_PUBLIC_ANALYTICS_ID=

SQUARESPACE_STORE_URL=https://invinity-store.squarespace.com
SANITY_PROJECT_ID=
SANITY_DATASET=production

EMAIL_FROM=house@invinity.ca
EMAIL_TO_HOUSE=house@invinity.ca

# If forms post to Formspree instead of a server action:
FORMSPREE_ENDPOINT=

# --- App secrets ------------------------------------------------------------
SQUARESPACE_API_KEY=
SANITY_READ_TOKEN=
RESEND_API_KEY=
