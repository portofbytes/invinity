# -----------------------------------------------------------------------------
# Invinity → Cloudflare Pages/Workers deploy config. Copy to scripts/deploy.env
# and fill in. Then: bash scripts/deploy.sh   (or deploy.ps1 on Windows)
# (scripts/deploy.env is gitignored.)
# -----------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------
GITHUB_REPO=portofbytes/invinity

# --- Optional ---------------------------------------------------------------
GIT_BRANCH=main
REPO_VISIBILITY=public

# --- Cloudflare credentials (pushed as repo secrets so Actions can deploy) --
# Account ID:  dash.cloudflare.com → right sidebar "Account ID"
# API token:   My Profile → API Tokens → Create → "Edit Cloudflare Workers"
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- App variables (non-secret) --------------------------------------------
NEXT_PUBLIC_SITE_URL=https://invinity.ca
NEXT_PUBLIC_ANALYTICS_ID=

SQUARESPACE_STORE_URL=
SANITY_PROJECT_ID=
SANITY_DATASET=production

EMAIL_FROM=house@invinity.ca
EMAIL_TO_HOUSE=house@invinity.ca

# --- App secrets ------------------------------------------------------------
SQUARESPACE_API_KEY=
SANITY_READ_TOKEN=
RESEND_API_KEY=
